<Project>
  <!-- Restore/build only the desktop-compatible target of each dependency. -->
  <PropertyGroup>
    <TargetFrameworks Condition="$([System.String]::Copy('$(TargetFrameworks)').Contains('net472'))">net472</TargetFrameworks>
    <TargetFrameworks Condition="$([System.String]::Copy('$(TargetFrameworks)').Contains('net461'))">net472</TargetFrameworks>
    <TargetFrameworks Condition="$([System.String]::Copy('$(TargetFrameworks)').Contains('netstandard2.0'))">netstandard2.0</TargetFrameworks>
    <!-- Native runtime packaged for Linux: linux-x64 (default) or linux-arm64.
         Managed code is AnyCPU IL and is JIT-compiled natively by Mono on either. -->
    <MissionPlannerLinuxRid Condition="'$(MissionPlannerLinuxRid)' == ''">linux-x64</MissionPlannerLinuxRid>
    <MissionPlannerLinuxNativeDir Condition="'$(MissionPlannerLinuxRid)' == 'linux-x64'">x64</MissionPlannerLinuxNativeDir>
    <MissionPlannerLinuxNativeDir Condition="'$(MissionPlannerLinuxRid)' == 'linux-arm64'">arm64</MissionPlannerLinuxNativeDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'MissionPlanner'">
    <!-- Match the application's managed SkiaSharp version. -->
    <PackageReference Update="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" GeneratePathProperty="true" />
    <Reference Include="Mono.Posix">
      <HintPath>$(MonoPosixPath)</HintPath>
    </Reference>
  </ItemGroup>
  <!-- The package's desktop targets copy glibc and musl to the same path.
       Select glibc explicitly for the Ubuntu/Debian download. -->
  <Target Name="CopyLinuxSkia" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'MissionPlanner' And '$(TargetFramework)' != ''">
    <Error Condition="'$(MissionPlannerLinuxNativeDir)' == ''"
           Text="Unsupported MissionPlannerLinuxRid '$(MissionPlannerLinuxRid)'. Use linux-x64 or linux-arm64." />
    <Copy SourceFiles="$(PkgSkiaSharp_NativeAssets_Linux_NoDependencies)/runtimes/$(MissionPlannerLinuxRid)/native/libSkiaSharp.so"
          DestinationFiles="$(TargetDir)$(MissionPlannerLinuxNativeDir)/libSkiaSharp.so" />
  </Target>
</Project>
