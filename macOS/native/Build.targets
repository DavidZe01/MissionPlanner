<Project>
  <!--
    Mission Planner as a native macOS app: every project builds for .NET for macOS
    (net10.0-macos) and uses Windows Forms and System.Drawing from
    ExtLibs/mac-playground (Cocoa windows, CoreGraphics drawing) instead of
    .NET Framework/Mono. Used through DirectoryBuildTargetsPath (macOS/native/build.sh).
  -->
  <PropertyGroup>
    <MacPlaygroundDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../ExtLibs/mac-playground/'))</MacPlaygroundDir>
    <IsMacPlaygroundProject Condition="$(MSBuildProjectDirectory.Replace('\','/').Contains('/ExtLibs/mac-playground/'))">true</IsMacPlaygroundProject>
    <!-- Projects that use Windows Forms or System.Drawing, and the ones that reference
         them. The other libraries stay netstandard2.0, which .NET for macOS runs as is. -->
    <MissionPlannerMacProjects>;MissionPlanner;MissionPlanner.Controls;BSE.Windows.Forms;BaseClasses;ZedGraph;GMap.NET.WindowsForms;GMap.NET.Drawing;MissionPlanner.Maps;OSDConfigurator;SvgNet;AviFile;DirectShowLib;WebCamService;GDAL.NET;tlogThumbnailHandler;</MissionPlannerMacProjects>
    <IsMissionPlannerMacProject Condition="$(MissionPlannerMacProjects.Contains(';$(MSBuildProjectName);'))">true</IsMissionPlannerMacProject>
  </PropertyGroup>

  <!-- Only Mission Planner itself is an app (solo, WebAPIs and px4uploader are Exe only
       when MissionPlannerMacNative is not set: this file comes too late for the SDK). -->
  <PropertyGroup Condition="'$(IsMacPlaygroundProject)' != 'true' And '$(MSBuildProjectName)' != 'MissionPlanner'">
    <OutputType>Library</OutputType>
    <StartupObject></StartupObject>
  </PropertyGroup>

  <!-- the mac-playground projects keep their own settings -->
  <Import Project="$(MacPlaygroundDir)Directory.Build.targets" Condition="'$(IsMacPlaygroundProject)' == 'true'" />

  <PropertyGroup Condition="'$(IsMissionPlannerMacProject)' == 'true'">
    <TargetFrameworks>net10.0-macos</TargetFrameworks>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);MACNATIVE</DefineConstants>
    <!-- platform-compatibility analysis would flag every Windows-only call that is
         already guarded at run time; obsolete-API warnings are upstream's -->
    <NoWarn>$(NoWarn);CA1416;CA1422;NU1701;NU1702;NU1603;NU1608;SYSLIB0001;SYSLIB0003;SYSLIB0006;SYSLIB0011;SYSLIB0012;SYSLIB0014;SYSLIB0021;SYSLIB0022;SYSLIB0023;SYSLIB0039;SYSLIB0050;SYSLIB0051;MSB3245;MSB3243;CS0618;CS0612</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Nullable>disable</Nullable>
    <!-- C# 12 (global usings, ref to in arguments) without the C# 13/14 changes (field, ...) -->
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsMissionPlannerMacProject)' == 'true'">
    <!-- .NET Framework and NuGet Windows Forms/System.Drawing: replaced by mac-playground -->
    <PackageReference Remove="System.Drawing.Common" />
    <PackageReference Remove="Microsoft.NETFramework.ReferenceAssemblies" />
    <Reference Remove="System.Windows.Forms;System.Drawing;System.Design;System.Drawing.Design;WindowsBase;PresentationCore;PresentationFramework;System.Windows.Forms.DataVisualization" />
    <ProjectReference Include="$(MacPlaygroundDir)System.Windows.Forms/System.Windows.Forms.csproj" />
    <ProjectReference Include="$(MacPlaygroundDir)System.Windows.Forms.Primitives/System.Windows.Forms.Primitives.csproj" />
    <ProjectReference Include="$(MacPlaygroundDir)System.Drawing.Common/System.Drawing.Common.csproj" />
    <ProjectReference Include="$(MacPlaygroundDir)MacApi/MacApi.csproj" />
    <!-- System.Drawing as .NET Framework had it, for binaries built against it -->
    <ProjectReference Include="$(MacPlaygroundDir)System.Drawing.Facade/System.Drawing.csproj" />
    <!-- its GLControl needs .NET Framework's Windows Forms and Carbon: see GLControl.cs -->
    <PackageReference Remove="OpenTK.GLControl" />
    <!-- .NET Framework APIs that are separate packages on .NET -->
    <PackageReference Include="System.Security.Permissions" Version="10.0.14" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition="'$(IsMissionPlannerMacProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)GlobalUsings.cs" Link="macOS/GlobalUsings.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'MissionPlanner'">
    <Compile Include="$(MSBuildThisFileDirectory)MacNative.cs" Link="macOS/MacNative.cs" />
    <!-- MISSIONPLANNER_TOUR=1 runs the screen tour inside the app -->
    <Compile Include="$(MSBuildThisFileDirectory)../ScreenTour.cs" Link="macOS/ScreenTour.cs" />
    <!-- Windows Forms resources (images, image lists) are BinaryFormatter data: .NET 9+ needs
         the compatibility implementation, enabled in the runtime configuration below -->
    <PackageReference Include="System.Runtime.Serialization.Formatters" Version="10.0.14" />
    <RuntimeHostConfigurationOption Include="System.Runtime.Serialization.EnableUnsafeBinaryFormatterSerialization" Value="true" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.4" />
    <!-- made by the build script from the Windows icon (sips/iconutil) -->
    <BundleResource Include="$(MSBuildThisFileDirectory)obj/MissionPlanner.icns" Condition="Exists('$(MSBuildThisFileDirectory)obj/MissionPlanner.icns')" LogicalName="MissionPlanner.icns" />
    <PackageReference Remove="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <!-- not used (the LIB build leaves it out too); its Accord.Imaging build needs CoreCompat.System.Drawing -->
    <Compile Remove="Utilities/ImageMatch.cs" />
    <!-- Windows-only at run time; Mission Planner checks the platform before using them -->
    <PackageReference Include="System.Speech" Version="10.0.14" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.14" />
  </ItemGroup>

  <!-- System.IO.Ports 4.7.0 has no osx-arm64 build of its native helper
       (System.IO.Ports.Native): every serial port failed to open with DllNotFoundException
       (USB telemetry, firmware upload, SiK radios). 10.x has one; Windows keeps 4.7.0. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'MissionPlanner' Or '$(MSBuildProjectName)' == 'MissionPlanner.Comms' Or '$(MSBuildProjectName)' == 'Ntrip'">
    <PackageReference Update="System.IO.Ports" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'MissionPlanner.Controls'">
    <Compile Include="$(MSBuildThisFileDirectory)GLControl.cs" Link="macOS/GLControl.cs" />
    <!-- came with the OpenTK.GLControl package before -->
    <PackageReference Include="OpenTK" Version="3.1.0" />
  </ItemGroup>

  <!-- The GDAL package also has content files for any framework, so NuGet does not fall
       back to its .NET Framework assemblies: reference them directly. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'GDAL.NET' Or '$(MSBuildProjectName)' == 'MissionPlanner'">
    <Reference Include="$(NuGetPackageRoot)gdal/2.3.2/lib/net40/gdal_csharp.dll" />
    <Reference Include="$(NuGetPackageRoot)gdal/2.3.2/lib/net40/gdalconst_csharp.dll" />
    <Reference Include="$(NuGetPackageRoot)gdal/2.3.2/lib/net40/ogr_csharp.dll" />
    <Reference Include="$(NuGetPackageRoot)gdal/2.3.2/lib/net40/osr_csharp.dll" />
  </ItemGroup>

  <!-- the app bundle -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'MissionPlanner'">
    <ApplicationId>org.ardupilot.missionplanner</ApplicationId>
    <ApplicationTitle>Mission Planner</ApplicationTitle>
    <AssemblyName>MissionPlanner</AssemblyName>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(MissionPlannerMacCompileOnly)' != 'true'">osx-arm64</RuntimeIdentifier>
    <AppBundleManifest>$(MSBuildThisFileDirectory)Info.plist</AppBundleManifest>
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
    <!-- .NET for macOS turns these off by default: Windows Forms resources need custom
         resource readers (as eM Client's test app), and exception messages are clearer -->
    <CustomResourceTypesSupport>true</CustomResourceTypesSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!-- the static registrar (as eM Client's test app) -->
    <MonoBundlingExtraArgs>--registrar:static</MonoBundlingExtraArgs>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsMissionPlannerMacProject)' == 'true'">
    <!-- packages that only have .NET Framework builds (GDAL, SSH.NET, zlib.net, ...) -->
    <AssetTargetFallback>$(AssetTargetFallback);net45;net451;net452;net40;net403;net35;net20</AssetTargetFallback>
  </PropertyGroup>

  <!-- version.txt next to the assembly, as Linux/build.sh and the Windows build write it
       (version.exe): the update check compares it with the published version. -->
  <Target Name="MissionPlannerMacVersionFile" AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(MSBuildProjectName)' == 'MissionPlanner'">
    <GetAssemblyIdentity AssemblyFiles="@(IntermediateAssembly)">
      <Output TaskParameter="Assemblies" ItemName="_MissionPlannerIdentity" />
    </GetAssemblyIdentity>
    <WriteLinesToFile File="$(OutDir)version.txt" Lines="%(_MissionPlannerIdentity.Version)" Overwrite="true" />
  </Target>

  <!-- OpenTK 3 has OpenGL ES bindings for iOS next to the desktop ones: their P/Invokes make
       the SDK link with OpenGLES, which macOS does not have. -->
  <Target Name="MissionPlannerMacNoOpenGLES" AfterTargets="_LoadLinkerOutput" BeforeTargets="_ComputeLinkNativeExecutableInputs"
          Condition="'$(MSBuildProjectName)' == 'MissionPlanner'">
    <ItemGroup>
      <_LinkerFrameworks Remove="OpenGLES" />
    </ItemGroup>
  </Target>

  <!-- As in the net472 builds, MissionPlanner.Drawing (a Skia System.Drawing for Android)
       is only visible under an alias, so its types do not clash with System.Drawing's. -->
  <Target Name="MissionPlannerMacAliasDrawing" AfterTargets="ResolveAssemblyReferences"
          Condition="'$(IsMissionPlannerMacProject)' == 'true'">
    <ItemGroup>
      <ReferencePath Condition="'%(Filename)' == 'MissionPlanner.Drawing' And '%(ReferencePath.Aliases)' == ''">
        <Aliases>ignore</Aliases>
      </ReferencePath>
      <!-- the System.Drawing facade replaces .NET's (same identity, lower version) -->
      <_MissionPlannerFrameworkDrawing Include="@(ReferencePath)"
          Condition="'%(Filename)' == 'System.Drawing' And $([System.String]::Copy('%(FullPath)').Contains('Microsoft.NETCore.App.Ref'))" />
      <ReferencePath Remove="@(_MissionPlannerFrameworkDrawing)" />
    </ItemGroup>
  </Target>
</Project>
